# ==============================
# Infinite Garden Git Ignore
# ==============================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Local development files
*.local

# Node / package files
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Personal media
*.jpg
*.jpeg
*.mp3
*.wav
*.m4a
*.ogg
